{{- /*
  An app's secrets, read by its containers' EnvironmentFile= and by its
  migrations: /etc/<app>/<app>.env, mode 0600, root. It reads the loop
  variable app and the role input app_secrets, which holds
  <app>_<VARIABLE> for each name in the app's secrets_from_vault, a mapping
  from each name to where its value comes from, which only the setup
  reads. A name missing from app_secrets fails the run and names it.
*/ -}}
# Managed by MMX: {{ .app.key }}'s secrets, from the vault. MMX hides this
# file's content in its output and results.
{{- if not (kindIs "map" .app.value.secrets_from_vault) }}{{ fail (printf "vars.apps.%s.secrets_from_vault in mmx_project_settings.yml is a list: write it as a mapping that names where each value comes from, as the template's example app does" .app.key) }}{{ end }}
{{- range $variable, $source := .app.value.secrets_from_vault }}
{{- $name := printf "%s_%s" $.app.key $variable }}
{{- if not (hasKey $.inputs.app_secrets $name) }}{{ fail (printf "the role input app_secrets has no %s: add it to the role call's app_secrets in playbooks/solo_server.yml" $name) }}{{ end }}
{{ $variable }}={{ index $.inputs.app_secrets $name }}
{{- end }}
