{{- /*
  An app's plain settings, read by its containers' EnvironmentFile= and by
  its migrations. It reads the loop variable app.

  R2_BUCKET comes only from production_uploads_r2_bucket, when that value is
  not "". The app and the setup's R2 key name the same bucket this way.
  MMX refuses to read a key an app leaves out, so the template looks for
  WEB_CONCURRENCY and R2_BUCKET in the app's env by ranging over its keys.
*/ -}}
# Managed by MMX from apps.{{ .app.key }}.env and production_uploads_r2_bucket in mmx_project_settings.yml.
# Podman reads each line as NAME=value and takes the value exactly as written.
{{- $settings := merge (dict) .app.value.env }}
{{- range $name, $value := $settings }}
{{- if eq $name "R2_BUCKET" }}{{ fail (printf "apps.%s.env sets R2_BUCKET. Remove it: the template writes R2_BUCKET from apps.%s.production_uploads_r2_bucket, so the app and its R2 key name the same bucket." $.app.key $.app.key) }}{{ end }}
{{- end }}
{{- if ne .app.value.production_uploads_r2_bucket "" }}{{ $_ := set $settings "R2_BUCKET" .app.value.production_uploads_r2_bucket }}{{ end }}
{{- range $name, $value := $settings }}
{{ $name }}={{ $value }}
{{- end }}
