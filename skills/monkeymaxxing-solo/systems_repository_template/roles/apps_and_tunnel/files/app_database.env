{{- /*
  An app's database settings, /etc/<app>/<app>_database.env, mode 0600, root,
  read by its containers and its migrations after the secrets file. It reads
  the loop variable app and the role inputs private_ip and app_secrets.

  DATABASE_URL names solo01's Postgres at its WireGuard address, with the
  connect timeout of 3 seconds that the Monkeymaxxing Stack's apps also use.
  DATABASE_READ_URL is the same: with one database server there is no
  replica to read from, and an app that sends reads there still works. The
  Postgres role has the database's name. The password is letters and digits,
  so it needs no escaping in the URL.
*/ -}}
{{- $database_name := .app.value.database_name -}}
{{- $password_name := printf "%s_database_password" $database_name -}}
{{- if not (hasKey .inputs.app_secrets $password_name) }}{{ fail (printf "the role input app_secrets has no %s: add it to the role call's app_secrets in playbooks/solo_server.yml" $password_name) }}{{ end -}}
# Managed by MMX: {{ .app.key }}'s database settings, from the vault. MMX hides
# this file's content in its output and results.
DATABASE_URL=postgresql://{{ $database_name }}:{{ index .inputs.app_secrets $password_name }}@{{ .inputs.private_ip }}:5432/{{ $database_name }}?connect_timeout=3
DATABASE_READ_URL=postgresql://{{ $database_name }}:{{ index .inputs.app_secrets $password_name }}@{{ .inputs.private_ip }}:5432/{{ $database_name }}?connect_timeout=3
